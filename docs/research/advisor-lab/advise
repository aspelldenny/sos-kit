#!/usr/bin/env bash
# advise — ask a stronger model for direction. Readable, logged, backend-switchable.
# Usage: advise [--backend claude|codex] [--model M] [--error-file F] "question"
# Env:   ADVISE_BACKEND (claude), ADVISE_MODEL (claude: opus; codex: Codex config default), ADVISE_BRIEF (path to brief)
# Claude backend loads only this prompt (no MCP/skills/settings): ~1-2k tokens instead of ~77k.
# Output: advice on stdout; a copy in evidence/advice/<timestamp>-<backend>.md
set -uo pipefail
backend="${ADVISE_BACKEND:-claude}"; model="${ADVISE_MODEL:-}"; errfile=""
while [ $# -gt 0 ]; do case "$1" in
  --backend) backend="$2"; shift 2;; --model) model="$2"; shift 2;;
  --error-file) errfile="$2"; shift 2;; *) break;; esac; done
question="${*:-What is the most likely root cause, and what should change next?}"
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$root" || exit 1

section() { printf '\n## %s\n' "$1"; }
{
  echo "You are the advisor to a worker agent coding in this repository. You do not edit files."
  echo "Give direction, not code dumps. Be concrete and short (under 300 words)."
  echo "Answer in exactly these parts:"
  echo "VERDICT: continue | change approach | stop and escalate"
  echo "WHY: the root cause or key insight, citing file:line or test names"
  echo "NEXT: 1-3 concrete steps for the worker"
  echo "RISKS: what the worker is likely missing (edge cases, other callers, data)"
  echo "CHECK: the single check that would prove the next step worked"
  section "Worker's question"; echo "$question"
  if [ -n "${ADVISE_BRIEF:-}" ] && [ -f "$ADVISE_BRIEF" ]; then section "Brief"; head -c 6000 "$ADVISE_BRIEF"; fi
  if [ -n "$errfile" ] && [ -f "$errfile" ]; then section "Latest failure"; tail -c 8000 "$errfile"; fi
  section "git status"; git status --short -- . ":(exclude)evidence" ":(exclude).advise-state" | head -50
  section "Recent commits"; git log --oneline -5 2>/dev/null
  section "Uncommitted diff (truncated)"; git diff HEAD -- . ":(exclude)evidence" ":(exclude).advise-state" | head -c 30000
} > "${TMPDIR:-/tmp}/advise-prompt.$$"

start=$(date +%s)
case "$backend" in
  claude) raw=$(claude -p --model "${model:-opus}" --tools "" --output-format json --strict-mcp-config --disable-slash-commands --setting-sources "" --system-prompt "You are a senior engineer advising a coding agent. You see a snapshot of its work; you do not edit files. Follow the requested answer format exactly." < "${TMPDIR:-/tmp}/advise-prompt.$$" 2>&1); rc=$?
          out=$(printf '%s' "$raw" | python3 -I -c "import json,sys; d=json.loads(sys.stdin.read().strip().splitlines()[-1]); print(d.get('result','')); print('\n(cost \$%.4f, model %s)' % (d.get('total_cost_usd') or 0, ','.join(d.get('modelUsage',{}).keys())))" 2>/dev/null) || out="$raw";;
  codex)  out=$(codex exec ${model:+-m "$model"} --sandbox read-only --skip-git-repo-check - < "${TMPDIR:-/tmp}/advise-prompt.$$" 2>/dev/null); rc=$?;;
  *) echo "advise: unknown backend $backend" >&2; exit 2;;
esac
secs=$(( $(date +%s) - start ))
rm -f "${TMPDIR:-/tmp}/advise-prompt.$$"
mkdir -p evidence/advice
log="evidence/advice/$(date +%Y%m%d-%H%M%S)-$backend.md"
{ echo "# advice ($backend ${model:-default}, ${secs}s, rc=$rc)"; echo; echo "**Q:** $question"; echo; echo "$out"; } > "$log"
if [ $rc -ne 0 ] || [ -z "$out" ]; then echo "advise: $backend failed (rc=$rc) — see $log" >&2; exit 1; fi
echo "$out"
echo; echo "(advice logged: $log, ${secs}s)"
