#!/usr/bin/env bash
# sos-kit v3 pre-commit — few gates, each fail-CLOSED, each failure says how to fix.
# Install: git config core.hooksPath hooks
#
#   1. Type check   (cargo check when Cargo.toml exists)
#   2. Trust gate   (auto-exec surfaces vs .sos-trust-baseline + hidden unicode) — kit only
#   3. sos gates    (`sos gate all` from the freshly built binary: gitleaks on the staged diff,
#                    .env commits, case collisions, default branch, wording, doc caps,
#                    FEATURES.json — config .sos.toml)
#   4. Docs check   (every path and `sos` command named in live docs exists: tests/docs-check.py)
#
# v2 gates (docs-gate freshness, phiếu/Discovery checks, lane-check, INV security-gate) and the
# v3.0 bash gates (block-env-commit, check-case-collision, no-code-on-default) are archived:
# see archive/v2/ and docs/plans/V3_TRIAGE_2026-10-08.md.

set -uo pipefail
FAILED=0
red()   { printf "\033[31m%s\033[0m\n" "$*"; }
green() { printf "\033[32m%s\033[0m\n" "$*"; }
blue()  { printf "\033[34m%s\033[0m\n" "$*"; }

# gate <label> <fix instruction> <command...>
gate() {
    local label="$1" fix="$2"; shift 2
    blue "[$label]"
    if "$@"; then
        green "  ✅ ok"
    else
        red "  ❌ blocked"
        echo "  → How to fix: $fix"
        FAILED=$((FAILED + 1))
    fi
}


if [ -f Cargo.toml ]; then
    gate "1/4 type check" "run \`cargo check\`, fix the compile errors, re-stage" \
        cargo check --quiet
fi

gate "2/4 trust gate" "review the auto-exec diff shown above; if it is intended, run \`scripts/trust-gate.sh rebaseline\` and stage .sos-trust-baseline" \
    bash -c '[ -f scripts/trust-gate.sh ] || { echo "  missing scripts/trust-gate.sh"; exit 1; }; bash scripts/trust-gate.sh'

# The kit runs its own freshly built binary; app repos call the installed `sos`.
gate "3/4 sos gates" "follow the → How to fix lines above; config lives in .sos.toml" \
    cargo run --quiet -p sos-cli -- gate all

gate "4/4 docs match the repo" "fix the path or command named above (or move the doc to archive/ if it is history)" \
    python3 tests/docs-check.py target/debug/sos

echo ""
if [ "$FAILED" -eq 0 ]; then
    green "✅ All checks passed."
else
    red "❌ $FAILED check(s) failed. Commit blocked."
    exit 1
fi
