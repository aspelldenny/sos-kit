#!/usr/bin/env bash
# sos-kit commit-msg: a fix commit names what caught the defect and the stage that let it
# through (`Caught-by: <layer>`, `Escaped-from: <stage>`), the ledger
# behind `sos score` (.sos.toml [ledger]). Runs the kit's freshly built binary (app repos call the
# installed `sos`). Install: git config core.hooksPath hooks
set -uo pipefail
cargo run --quiet -p sos-cli -- gate commit-msg "$1"
