{
  "name": "sos-kit",
  "version": "0.3.1",
  "description": "sos-kit — installs the sos CLI (SOS Kit v3 harness: install/update/check + git gates). Postinstall fetches install.sh@v0.3.1 (pinned tag, sha256-verified, fail-closed) and runs it.",
  "os": ["darwin", "linux"],
  "bin": {
    "sos": "bin/sos-npm",
    "sos-kit-setup": "scripts/npm-postinstall.sh"
  },
  "scripts": {
    "postinstall": "sh scripts/npm-postinstall.sh"
  },
  "files": [
    "scripts/npm-postinstall.sh",
    "scripts/install-sh.sha256",
    "bin/sos-npm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspelldenny/sos-kit.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=14"
  }
}
