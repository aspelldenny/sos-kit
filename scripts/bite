#!/usr/bin/env python3
"""bite — do the tests of a change catch a wrong version of that change? Agent-neutral CLI.

  bite [--base REF] [--head REF] [--test CMD] [--cwd DIR] [--src REGEX] [--tests REGEX] [--mutants N]
  bite --audit [--head REF] [--test CMD] [--src REGEX] [--tests REGEX] [--mutants N]

Why (Reel, 18/10/2026): 21 of 578 agent-written tests could not catch any bug (copied constants,
asserting what the test itself set, duplicate proofs); the contract's test rule was words, and the
reviewer only read code. This turns the rule into numbers, in a throwaway worktree at HEAD (source
and tests in the checkout are never touched; the result is written to evidence/bite/):

  1. before: the changed source files go back to BASE, the tests stay at HEAD. A new or edited test
     that still passes there proves nothing about this change (fine for a test that guards old
     behaviour on purpose; say so).
  2. mutants: up to N one-token edits (== -> !=, < -> >=, and -> or, True -> False, n -> n+1 ...)
     on code lines the change added, outside comments, strings and docstrings. A mutant no test
     kills is a changed line no test checks (or an equivalent edit; say why). A mutant after which
     no test ran (it broke the build) counts as neither.

  --audit: no change, the tests that already exist. Up to N mutants (default 30) spread over all code
     lines of --src at HEAD; lists tests that killed none, and tests whose kills another test also made.
     Why: OpenClaw (10/2026) reported deleting ~400k lines of its own tests with little coverage change; coverage
     counts lines run, not lines checked. These are candidates for review, not deletions: narrow --src
     and --test to one module so the sample means something.

Settings, strongest first: flags, `.sos.toml` [bite] (test, cwd, src, tests, mutants), defaults
(base: the merge base with origin/HEAD, else main; mutants 8). Per-test results are read from
`python -m unittest -v`, `pytest -v`, XCTest, `node --test`, `vitest --reporter=verbose`, `jest --verbose`,
TAP and `cargo test` output; with another runner the "before" check sees
only the suite verdict and a mutant counts as killed whenever the run fails.
Exit 0 measured, 1 not measurable (tests red at HEAD, nothing changed, git error), 2 not configured.
"""
import argparse, json, os, re, shutil, signal, subprocess, sys, tempfile, time
from pathlib import Path

if os.name == "nt" and not sys.flags.utf8_mode:  # Windows: files, pipes and stdout in UTF-8, not cp1252
    os.environ["PYTHONUTF8"] = "1"                  # (Vietnamese status text broke the hook, 23/10/2026)
    sys.exit(subprocess.run([sys.executable, *sys.argv]).returncode)

MUTATORS = [
    (r"===", "!=="), (r"!==", "==="), (r"(?<![!=])==(?!=)", "!="), (r"!=(?!=)", "=="), (r"<=", ">"), (r">=", "<"), (r"(?<=\s)<(?=\s)", ">="),
    (r"(?<=\s)>(?=\s)", "<="), (r"\band\b", "or"), (r"\bor\b", "and"), (r"&&", "||"), (r"\|\|", "&&"),
    (r"\bTrue\b", "False"), (r"\bFalse\b", "True"), (r"\btrue\b", "false"), (r"\bfalse\b", "true"),
    (r"\bnot ", ""), (r"(?<=\s)\+(?=\s)", "-"), (r"(?<=\s)-(?=\s)", "+"), (r"(?<![\w.])(\d+)(?![\w.])", None),
]
SKIP = re.compile(r"^\s*(#|//|/\*|\*(?:\s|/|$)|import |from \S+ import|use |\"\"\"|'''|@|print\(|"
                  r"(?:log|logger|logging|os_log|NSLog|console)\b[.(]|(?:e?println|dbg)!)")
DIFF = ["diff", "--no-color", "--no-ext-diff", "--no-renames", "--src-prefix=a/", "--dst-prefix=b/"]


def bash():
    """Windows: Git's own bash, so a test command reads the same as on macOS/Linux (`./run.sh`,
    `A=1 make test`); shell=True there is cmd.exe. A bare "bash" may be WSL's System32/bash.exe."""
    core = subprocess.run(["git", "--exec-path"], capture_output=True, text=True).stdout.strip()
    for rel in ("../../../bin/bash.exe", "../../../usr/bin/bash.exe"):  # <Git>/mingw64/libexec/git-core
        p = os.path.normpath(os.path.join(core, rel))
        if core and os.path.isfile(p):
            return p
    return shutil.which("bash") or "bash"


def sh(cmd, cwd, timeout=900):
    t = time.time()
    try:
        argv = [bash(), "-c", cmd] if os.name == "nt" else cmd
        r = subprocess.run(argv, shell=os.name != "nt", cwd=cwd, capture_output=True, text=True, errors="replace", timeout=timeout)
        return r.returncode, r.stdout + r.stderr, time.time() - t
    except subprocess.TimeoutExpired:
        return 124, "timeout", time.time() - t


def git(*a, cwd):
    return subprocess.run(["git", *a], cwd=cwd, capture_output=True, text=True, check=True).stdout


def read(p: Path):
    """File text, or None when it is not UTF-8 (such files are left alone)."""
    try:
        return p.read_bytes().decode("utf-8")
    except (UnicodeDecodeError, OSError):
        return None


def in_string(line, pos):
    q = None
    for i, c in enumerate(line[:pos]):
        if c in "\"'`" and (i == 0 or line[i - 1] != "\\"):
            q = None if q == c else (c if q is None else q)
    return q is not None


def added_lines(repo, base, head, pattern):
    """{file: [(line number at HEAD, text)]} for lines the change added in files matching pattern."""
    out, f, prev, n = {}, None, "", 0
    for l in git(*DIFF, "-U0", f"{base}..{head}", cwd=repo).splitlines():
        if l.startswith("+++ ") and prev.startswith("--- "):
            f = l[6:] if l.startswith("+++ b/") else None
            f = f if f and re.search(pattern, f) else None
        elif l.startswith("@@"):
            n = int(re.search(r"\+(\d+)", l).group(1))
        elif f and l.startswith("+"):
            out.setdefault(f, []).append((n, l[1:].rstrip("\r")))
            n += 1
        prev = l
    return out


def code_end(line):
    """Index where a trailing # or // comment starts (outside strings), else len(line)."""
    for m in re.finditer(r"#|//", line):
        if not in_string(line, m.start()):
            return m.start()
    return len(line)


def docstring_lines(text):
    """1-based line numbers inside triple-quoted blocks (Python docstrings, Swift multi-line strings)."""
    inside, out = False, set()
    for i, l in enumerate(text.split("\n"), 1):
        k = l.count('"""') + l.count("'''")
        if inside or k:
            out.add(i)
        if k % 2:
            inside = not inside
    return out


def mutants(lines, limit, root):
    cands = []
    for f, ls in lines.items():
        p = root / f
        if p.is_symlink() or root.resolve() not in p.resolve().parents:
            continue  # writing it would change a file outside the throwaway worktree
        text_all = read(p)
        if text_all is None:
            continue
        doc = docstring_lines(text_all)
        for n, text in ls:
            if not text.strip() or SKIP.search(text) or n in doc:
                continue
            code = text[:code_end(text)]
            for pat, rep in MUTATORS:
                m = re.search(pat, code)
                if not m or in_string(code, m.start()):
                    continue
                new = str(int(m.group(1)) + 1) if rep is None else rep
                cands.append((f, n, text, text[:m.start()] + new + text[m.end():]))
                break  # one mutant per line
    if len(cands) <= limit:
        return cands
    step = len(cands) / limit  # spread over the change, deterministic
    return [cands[int(i * step)] for i in range(limit)]


CLASS = re.compile(r"\s*(?:@\w+(?:\([^)]*\))?\s+)*(?:(?:public|internal|private|fileprivate|open|final)\s+)*class\s+(\w+)")
TEST_FN = re.compile(r"\s*(?:@\w+(?:\([^)]*\))?\s+)*(?:(?:public|internal|override|final)\s+)*(?:async\s+)?(?:def|func)\s+(test\w*)")
# node:test / vitest / jest: it('title', …) or test("title", …); Rust: fn after #[test] or #[tokio::test].
JS_TEST = re.compile(r"\s*(?:it|test)(?:\.(?:only|skip|todo|concurrent|fails))?\(\s*(['\"`])(.*?)(?<!\\)\1")
RUST_FN = re.compile(r"\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?fn\s+(\w+)")
RUST_TEST = re.compile(r"\s*#\[(?:\w+::)*test\b")
indent = lambda l: len(l) - len(l.lstrip())


def test_names(added, root):
    """Class.test for every test function the change added or edited (".test" when not in a class)."""
    out = set()
    for f, ls in added.items():
        text = read(root / f)
        if text is None:
            continue
        src = text.split("\n")
        touched = {n for n, _ in ls}
        for i, l in enumerate(src, 1):
            m, key = TEST_FN.match(l), None
            if not m and (j := JS_TEST.match(l)):
                key = "." + j.group(2)
            elif not m and (r := RUST_FN.match(l)) and any(RUST_TEST.match(x) for x in src[max(0, i - 4):i - 1]):
                key = "." + r.group(1)
            if not m and not key:
                continue
            # The test ends at the next non-blank line indented no deeper than its own header.
            end = next((j for j in range(i + 1, len(src) + 1) if src[j - 1].strip() and indent(src[j - 1]) <= indent(l)
                        and not src[j - 1].strip().startswith(("}", ")"))), len(src) + 1)
            while end - 1 > i and not src[end - 2].strip():  # trailing blank lines are not the test
                end -= 1
            if not touched & set(range(i, end)):
                continue
            if key:
                out.add(key)
                continue
            cls = ""
            for j in range(i - 2, -1, -1):
                c = CLASS.match(src[j])
                if c and indent(src[j]) < indent(l):
                    cls = c.group(1)
                    break
                if src[j].strip() and indent(src[j]) == 0 and not c:
                    break  # left the enclosing block: a top-level test function
            out.add(f"{cls}.{m.group(1)}")
    return out


def leaf_runs(out):
    """node:test, vitest, jest, TAP and cargo test output -> {title: [passed?, …]}, one entry per run of that title.
    node prints a failing test again under "failing tests:"; a suite ("▶ name", TAP type 'suite') and a file
    that did not load ("✖ test/a.test.mjs") are not tests. results() gives no verdict to a title run twice."""
    out_once = re.split(r"^✖ failing tests:$", out, maxsplit=1, flags=re.M)[0]
    suites = set(re.findall(r"^\s*▶ (.+)$", out_once, re.M))
    named = []  # (title, passed)
    for m in re.finditer(r"^(\s*)([✓✔√]|[×✕✖]) (.+?)(?: \(?\d+(?:\.\d+)? ?m?s\)?)?[ \t]*$", out_once, re.M):
        if m.group(3) not in suites:
            named.append((m.group(3).split(" > ")[-1], m.group(2) in "✓✔√"))
    for m in re.finditer(r"^(\s*)(not ok|ok) \d+ - (.+?)(\s+#\s*(?:SKIP|TODO)\b.*)?\n((?:\1 +.*\n)*)", out + "\n", re.M):
        if not m.group(4) and "type: 'suite'" not in m.group(5):
            named.append((m.group(3), m.group(2) == "ok"))
    for m in re.finditer(r"^test (\S+) \.\.\. (ok|FAILED)$", out, re.M):
        named.append((m.group(1).split("::")[-1], m.group(2) == "ok"))
    seen = {}
    for title, ok in named:
        if not re.fullmatch(r"(?:\S+|.*/.*|.*\.(?:test|spec))\.[cm]?[jt]sx?", title):  # else a file that did not load
            seen.setdefault(title, []).append(ok)
    return seen


def has_verdicts(out):
    return bool(results(out)) or bool(leaf_runs(out))


def any_failed(out):
    """Did some test fail (a kill), as opposed to a red run in which no test failed (a broken build)?"""
    return False in results(out).values() or any(False in oks for oks in leaf_runs(out).values())


def _cls(group, name):
    parts = group.split(".")
    return parts[-2] if parts[-1] == name and len(parts) > 1 else parts[-1]


def results(out):
    """unittest -v / pytest -v / XCTest lines -> {Class.test: passed?}; node:test, vitest, jest, TAP and
    cargo test lines -> {.title: passed?} (a title seen twice passes only if it passed every time)."""
    r = {}
    # unittest: "test_x (mod.Class.test_x) ... ok" (3.11+) or "(mod.Class)"; a docstring puts a line between.
    for m in re.finditer(r"^(test\w+) \(([^)]*)\)(?:\n[^\n]*?)? \.\.\. (ok|FAIL|ERROR|skipped|expected failure)", out, re.M):
        r[f"{_cls(m.group(2), m.group(1))}.{m.group(1)}"] = m.group(3) == "ok"
    for m in re.finditer(r"^(?:FAIL|ERROR): (test\w+) \(([^)]*)\)", out, re.M):  # subTest failures
        r[f"{_cls(m.group(2), m.group(1))}.{m.group(1)}"] = False
    # pytest -v: "tests/test_a.py::TestC::test_x PASSED" or "tests/test_a.py::test_x[param] FAILED"
    for m in re.finditer(r"^\S+?::(?:(\w+)::)?(test\w*)\S* (PASSED|FAILED|ERROR|XFAIL|XPASS)", out, re.M):
        key = f"{m.group(1) or ''}.{m.group(2)}"
        r[key] = r.get(key, True) and m.group(3) == "PASSED"
    # XCTest: "Test Case '-[Mod.Class testA]' passed", "Test case '-[Mod.Class testA()]' passed on …", Linux "'Class.testA'"
    for m in re.finditer(r"Test [Cc]ase '-?\[?(?:\w+\.)?(\w+)[ .](test\w*)(?:\(\))?\]?' (passed|failed)", out):
        r[f"{m.group(1)}.{m.group(2)}"] = m.group(3) == "passed"
    r.update({"." + t: oks[0] for t, oks in leaf_runs(out).items() if len(oks) == 1})
    return r


def settings(root: Path) -> dict:
    s = {"test": "", "cwd": ".", "src": "", "tests": "", "mutants": 8}
    cfg = root / ".sos.toml"
    if not cfg.exists():
        return s
    text = cfg.read_text(errors="replace")
    try:
        import tomllib
        try:
            s.update({k: v for k, v in tomllib.loads(text).get("bite", {}).items() if k in s})
        except tomllib.TOMLDecodeError as e:
            raise SystemExit(f"bite: .sos.toml is not valid TOML ({e}); `sos check` shows where")
    except ImportError:  # Python < 3.11: read [bite] by hand
        sect = re.search(r"^\[bite\]\s*$(.*?)(?=^\[|\Z)", text, re.M | re.S)
        for m in re.finditer(r"^\s*(\w+)\s*=\s*(?:'([^']*)'|\"((?:[^\"\\]|\\.)*)\"|(\d+))", sect.group(1) if sect else "", re.M):
            k = m.group(1)
            if k in s:
                s[k] = (int(m.group(4)) if m.group(4) else m.group(2) if m.group(2) is not None
                        else re.sub(r"\\(.)", r"\1", m.group(3)))
    return s


CACHES = {".cache", ".vite", ".vitest", ".vite-temp", ".tmp"}


def link_deps(root: Path, wt: Path, cwd: str, links: list):
    """Installed dependencies are not in git. The worktree gets its own node_modules folder whose entries
    link to the checkout's (or the main checkout's, when this one is a worktree without them); the runners'
    cache folders stay real folders in the worktree, so a run does not write into the checkout's. Each link
    made is appended to `links`, for remove_worktree()."""
    main = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=root).strip()).parent
    for d in sorted({Path("node_modules"), Path(cwd) / "node_modules"}, key=lambda d: len(d.parts)):
        src = next((r / d for r in (root, main) if (r / d).is_dir()), None)
        # `cwd` under a linked package resolves into the checkout: never create anything there.
        if not src or (wt / d).exists() or not inside(wt, (wt / d).parent):
            continue
        try:
            (wt / d).mkdir(parents=True)
            for e in src.iterdir():
                if e.name not in CACHES:
                    link(e, wt / d / e.name)
                    links.append(wt / d / e.name)
        except OSError:
            pass  # the test command fails and says why


def inside(wt: Path, p: Path) -> bool:
    """p, with every symlink and junction resolved, is in the throwaway worktree."""
    return p.resolve().is_relative_to(wt.resolve())


def link(src: Path, dst: Path):
    """dst -> src. A Windows symlink needs Developer Mode or admin rights; without them a folder gets a
    junction and a file a copy (no node_modules reached the worktree there, 23/10/2026)."""
    try:
        dst.symlink_to(src, target_is_directory=src.is_dir())
    except OSError:
        if os.name != "nt":
            raise
        if src.is_dir():
            import _winapi
            _winapi.CreateJunction(str(src), str(dst))
        else:
            shutil.copy2(src, dst)


def remove_worktree(root: Path, wt: Path, links: list):
    """Git for Windows' `worktree remove` deletes through a junction: it emptied the checkout's own
    node_modules (23/10/2026). The links link_deps() made are removed first, the link only, and only
    where the folder holding it is still in the worktree. A run killed outright (TerminateProcess,
    SIGKILL) skips this: remove a leftover sos-bite-* worktree by hand, links first."""
    for e in reversed(links):
        if is_link(e) and inside(wt, e.parent):
            (os.unlink if e.is_symlink() else os.rmdir)(e)  # a POSIX symlink to a folder is not rmdir'able; a junction is
    subprocess.run(["git", "worktree", "remove", "--force", str(wt)], cwd=root, capture_output=True)


def is_link(p: Path) -> bool:
    """A symlink or a Windows junction (Path.is_junction() is Python 3.12+)."""
    try:
        return p.is_symlink() or bool(getattr(os.lstat(p), "st_file_attributes", 0) & 0x400)  # REPARSE_POINT
    except OSError:
        return False


def default_base(root: Path) -> str:
    for ref in ("origin/HEAD", "origin/main", "main", "master"):
        r = subprocess.run(["git", "merge-base", "HEAD", ref], cwd=root, capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    return "HEAD~1"


def measure(root: Path, base: str, head: str, s: dict) -> dict:
    head = git("rev-parse", head, cwd=root).strip()
    base = git("rev-parse", base, cwd=root).strip()
    rep = {"base": base[:10], "head": head[:10], "test": s["test"]}
    if base == head:
        rep["error"] = f"base and head are the same commit ({head[:10]}): pass --base <the commit before the change>"
        return rep
    subprocess.run(["git", "worktree", "prune"], cwd=root, capture_output=True)  # a run killed by SIGKILL
    wt = Path(tempfile.mkdtemp(prefix="sos-bite-"))
    git("worktree", "add", "-q", "--detach", str(wt), head, cwd=root)
    links = []
    try:
        link_deps(root, wt, s["cwd"], links)
        run = wt / s["cwd"]
        if not inside(wt, run):
            rep["error"] = f"cwd {s['cwd']!r} resolves outside the throwaway worktree (through a link): not run"
            return rep
        rc, head_out, secs = sh(s["test"], run)
        rep["suite_seconds"] = round(secs, 1)
        if rc != 0:
            rep["error"] = "tests are red at HEAD: " + head_out.strip()[-600:]
            return rep
        per_test = has_verdicts(head_out)
        changed = git(*DIFF, "--name-only", "-z", f"{base}..{head}", cwd=root).split("\0")
        src = [f for f in changed if f and re.search(s["src"], f) and not re.search(s["tests"], f)]
        tadded = {f: ls for f, ls in added_lines(root, base, head, s["tests"]).items() if (wt / f).is_file()}
        new_tests = sorted(test_names(tadded, wt))
        rep["src_files"], rep["tests_touched"] = src, new_tests
        # 1. before: source at BASE, tests at HEAD
        existed = set(git("ls-tree", "-r", "-z", "--name-only", base, cwd=root).split("\0"))
        for f in src:
            if f in existed:
                git("checkout", base, "--", f, cwd=wt)
            else:
                (wt / f).unlink(missing_ok=True)
        rc, out, _ = sh(s["test"], run)
        res = results(out)
        rep["before"] = {"suite_failed": rc != 0,
                         "pass_on_old_code": [t for t in new_tests if res.get(t) is True],
                         "no_verdict": [t for t in new_tests if t not in res]}
        git("reset", "-q", "--hard", head, cwd=wt)  # also drops base-only files put back above
        # 2. mutants on added source lines
        rep["mutants"] = []
        for f, n, old, new in mutants({f: ls for f, ls in added_lines(root, base, head, s["src"]).items() if f in src},
                                      int(s["mutants"]), wt):
            p = wt / f
            orig = p.read_bytes()
            lines = orig.decode("utf-8").split("\n")
            cr = "\r" if lines[n - 1].endswith("\r") else ""
            if lines[n - 1].rstrip("\r") != old:
                continue
            lines[n - 1] = new + cr
            p.write_bytes("\n".join(lines).encode("utf-8"))
            rc, out, secs = sh(s["test"], run)
            p.write_bytes(orig)
            # With per-test verdicts a kill is a test that failed; a red run without one did not reach the
            # tests (the mutant broke the build, or a test file no longer loads).
            ran = rc == 0 or not per_test or any_failed(out)
            i = next((j for j, (x, y) in enumerate(zip(old, new)) if x != y), 0)
            rep["mutants"].append({"at": f"{f}:{n}", "from": old[max(0, i - 40):i + 40].strip(),
                                   "to": new[max(0, i - 40):i + 40].strip(), "killed": ran and rc != 0,
                                   "no_tests_ran": not ran, "seconds": round(secs, 1)})
        return rep
    finally:
        remove_worktree(root, wt, links)


def audit(root: Path, head: str, s: dict) -> dict:
    """Which existing tests kill no mutant, or only mutants another test also kills? Candidates for removal."""
    head = git("rev-parse", head, cwd=root).strip()
    rep = {"head": head[:10], "test": s["test"], "audit": True}
    subprocess.run(["git", "worktree", "prune"], cwd=root, capture_output=True)
    wt = Path(tempfile.mkdtemp(prefix="sos-bite-"))
    git("worktree", "add", "-q", "--detach", str(wt), head, cwd=root)
    links = []
    try:
        link_deps(root, wt, s["cwd"], links)
        run = wt / s["cwd"]
        if not inside(wt, run):
            rep["error"] = f"cwd {s['cwd']!r} resolves outside the throwaway worktree (through a link): not run"
            return rep
        rc, out, secs = sh(s["test"], run)
        rep["suite_seconds"] = round(secs, 1)
        if rc != 0:
            rep["error"] = "tests are red at HEAD: " + out.strip()[-600:]
            return rep
        green = sorted(t for t, ok in results(out).items() if ok)
        if not has_verdicts(out):
            rep["error"] = "no per-test verdicts in the test output: the audit needs one of the runners listed at the top of scripts/bite"
            return rep
        files = [f for f in git("ls-files", "-z", cwd=wt).split("\0")
                 if f and re.search(s["src"], f) and not re.search(s["tests"], f)]
        lines = {}
        for f in files:
            text = read(wt / f)
            if text is not None:
                lines[f] = [(n, l.rstrip("\r")) for n, l in enumerate(text.split("\n"), 1)]
        kills, rep["mutants"] = {t: [] for t in green}, []
        for f, n, old, new in mutants(lines, int(s["mutants"]), wt):
            p = wt / f
            orig = p.read_bytes()
            ls = orig.decode("utf-8").split("\n")
            ls[n - 1] = new + ("\r" if ls[n - 1].endswith("\r") else "")
            p.write_bytes("\n".join(ls).encode("utf-8"))
            rc, out, secs = sh(s["test"], run)
            p.write_bytes(orig)
            res = results(out)
            by = [t for t in green if res.get(t) is False]
            i = next((j for j, (x, y) in enumerate(zip(old, new)) if x != y), 0)
            killed = rc != 0 and any_failed(out)
            rep["mutants"].append({"at": f"{f}:{n}", "to": new[max(0, i - 40):i + 40].strip(), "killed_by": by,
                                   "killed": killed, "no_tests_ran": rc != 0 and not killed, "seconds": round(secs, 1)})
            for t in by:
                kills[t].append(f"{f}:{n}")
        rep["kills"] = kills
        rep["killed_nothing"] = [t for t in green if not kills[t]]
        # A test whose kills are all killed by one other test adds no proof on this sample.
        rep["covered_by"] = {t: o for t in green if kills[t] for o in green
                             if o != t and set(kills[t]) <= set(kills[o])
                             and (set(kills[t]) < set(kills[o]) or o < t)}
        return rep
    finally:
        remove_worktree(root, wt, links)


def main() -> int:
    ap = argparse.ArgumentParser(prog="bite")
    for k in ("base", "head", "test", "cwd", "src", "tests"):
        ap.add_argument(f"--{k}")
    ap.add_argument("--mutants", type=int)
    ap.add_argument("--audit", action="store_true", help="mutate all of --src at HEAD and list tests that add no kill")
    a = ap.parse_args()
    try:
        root = Path(git("rev-parse", "--show-toplevel", cwd=Path.cwd()).strip())
    except subprocess.CalledProcessError:
        print("bite: not inside a git repository", file=sys.stderr)
        return 1
    s = settings(root)
    s.update({k: v for k, v in vars(a).items() if v is not None and k in s})
    missing = [k for k in ("test", "src", "tests") if not s[k]]
    if missing:
        print(f"bite: set {', '.join(missing)} in .sos.toml [bite] (or --{missing[0]}); see harness-lite/templates/sos.toml",
              file=sys.stderr)
        return 2
    if Path(s["cwd"]).is_absolute() or Path(s["cwd"]).anchor or ".." in Path(s["cwd"]).parts:  # Windows: \repo
        print(f"bite: cwd must be a path inside the repo ({s['cwd']!r}): the tests would run outside the throwaway worktree",
              file=sys.stderr)
        return 2
    # SIGTERM/SIGHUP (an agent's timeout, a closed terminal) must still remove the worktree.
    # Windows has no SIGHUP (bite died on it, POD-agent 23/10/2026); a closed console sends SIGBREAK.
    for name in ("SIGTERM", "SIGHUP", "SIGBREAK"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), lambda *_: sys.exit(130))
    if a.audit and a.mutants is None:
        s["mutants"] = max(int(s["mutants"]), 30)
    try:
        rep = audit(root, a.head or "HEAD", s) if a.audit else measure(root, a.base or default_base(root), a.head or "HEAD", s)
    except subprocess.CalledProcessError as e:
        print(f"bite: git failed: {' '.join(e.cmd)}: {(e.stderr or '').strip()[:300]}", file=sys.stderr)
        return 1
    (root / "evidence" / "bite").mkdir(parents=True, exist_ok=True)
    rec = root / "evidence" / "bite" / f"{time.strftime('%Y%m%d-%H%M%S')}-{rep['head']}.json"
    rec.write_text(json.dumps(rep, indent=1, ensure_ascii=False) + "\n")
    if "error" in rep:
        print(f"bite: not measured, {rep['error']}", file=sys.stderr)
        return 1
    if a.audit:
        ms = [m for m in rep["mutants"] if not m["no_tests_ran"]]
        print(f"bite --audit {rep['head']}: {len(rep['kills'])} tests, {sum(m['killed'] for m in ms)}/{len(ms)} "
              f"mutants killed; {len(rep['killed_nothing'])} tests killed none; {len(rep['covered_by'])} killed only "
              f"what one other test also killed (listed in the result file) (suite {rep['suite_seconds']} s)")
        for t in rep["killed_nothing"]:
            print(f"  killed none: {t}")
        for m in ms:
            if not m["killed"]:
                print(f"  survived: {m['at']}  ->  {m['to']}")
        for m in rep["mutants"]:
            if m["no_tests_ran"]:
                print(f"  not counted (no test failed, build broke?): {m['at']}  {m['to']}")
        print("  (candidates, not verdicts: a test may guard lines this sample missed or a contract no mutant reaches;"
              f" full result: {rec.relative_to(root)})")
        return 0
    ms, b = rep["mutants"], rep["before"]
    counted = [m for m in ms if not m["no_tests_ran"]]
    print(f"bite {rep['base']}..{rep['head']}: {sum(m['killed'] for m in counted)}/{len(counted)} mutants killed; "
          f"{len(b['pass_on_old_code'])}/{len(rep['tests_touched'])} new or edited tests pass on the old code"
          f" (suite {rep['suite_seconds']} s)")
    for t in b["pass_on_old_code"]:
        print(f"  passes on old code: {t}")
    for t in b["no_verdict"]:
        print(f"  no per-test verdict: {t}" + ("" if b["suite_failed"] else " (the old-code suite passed)"))
    for m in counted:
        if not m["killed"]:
            print(f"  survived: {m['at']}  {m['from']}  ->  {m['to']}")
    for m in ms:
        if m["no_tests_ran"]:
            print(f"  not counted (no test ran, build broke?): {m['at']}  {m['to']}")
    print(f"  (full result: {rec.relative_to(root)})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
