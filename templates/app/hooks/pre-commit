#!/usr/bin/env bash
# SOS Kit pre-commit. Kit-owned: `sos update` replaces this file; project rules live in .sos.toml.
# `sos gate pre-commit` runs every gate (secrets, .env commits, case collisions, default branch, wording,
# doc size caps, FEATURES.json), then harness-lite/hooks/pre-commit.local if it exists (optional, project-owned).
command -v sos >/dev/null 2>&1 || { echo "⛔ sos is not installed — commit refused."; echo "  → How to fix: install sos (https://github.com/aspelldenny/sos-kit#quick-start), then commit again."; exit 1; }
sos gate pre-commit --local "$0.local" "$@" || { rc=$?; [ "$rc" = 2 ] && echo "  (exit 2: .sos.toml is invalid, or sos is older than this hook — upgrade: https://github.com/aspelldenny/sos-kit#quick-start)"; exit "$rc"; }
