#!/usr/bin/env bash
# SOS Kit pre-push. Kit-owned: `sos update` replaces this file.
# `sos gate pre-push` checks tokens in .git/config and agent config files and that real .env files are
# ignored and untracked, then runs harness-lite/hooks/pre-push.local if it exists (optional, project-owned).
command -v sos >/dev/null 2>&1 || { echo "⛔ sos is not installed — push refused."; echo "  → How to fix: install sos (https://github.com/aspelldenny/sos-kit#quick-start), then push again."; exit 1; }
sos gate pre-push --local "$0.local" "$@" || { rc=$?; [ "$rc" = 2 ] && echo "  (exit 2: .sos.toml is invalid, or sos is older than this hook — upgrade: https://github.com/aspelldenny/sos-kit#quick-start)"; exit "$rc"; }
