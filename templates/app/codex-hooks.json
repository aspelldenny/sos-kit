{
  "description": "SOS Kit: translates Codex hook payloads to harness-lite/scripts. The git pre-commit is the real gate.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/harness-lite/adapters/codex/hook.py\" session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/harness-lite/adapters/codex/hook.py\" pre-edit"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/harness-lite/adapters/codex/hook.py\" post-bash",
            "timeout": 340
          }
        ]
      }
    ]
  }
}
