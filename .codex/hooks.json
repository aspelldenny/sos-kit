{
  "description": "SOS Kit v3 Codex adapter: translates payloads to agent-neutral scripts/. The git pre-commit is the real gate.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/adapters/codex/hook.py\" session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/adapters/codex/hook.py\" pre-edit"
          }
        ]
      }
    ]
  }
}
