#!/bin/sh
# bin/sos-npm — npm `bin` entry point for sos-kit (P081b, Stage 2).
#
# THIN delegate, NOT a second dispatch route: the real `sos` launcher is the
# wrapper install.sh writes to $BIN_DIR/sos (default ~/.local/bin/sos), which
# in turn execs bin/sos.sh in the cloned kit checkout (route A, canonical).
# This file only forwards to that wrapper — if it's missing (postinstall was
# skipped via --ignore-scripts, or failed), print how to fix it instead of
# silently half-dispatching.

set -eu

BIN_DIR="${SOS_BIN_DIR:-$HOME/.local/bin}"
TARGET="$BIN_DIR/sos"

if [ ! -x "$TARGET" ]; then
  echo "✗ sos-kit is not installed yet ($TARGET not found or not executable)." >&2
  echo "  This npm package only ships a thin delegate — the real install runs via" >&2
  echo "  postinstall (skipped here, e.g. --ignore-scripts was used)." >&2
  echo "  Run it by hand:" >&2
  echo "    npx --package=sos-kit sos-kit-setup" >&2
  echo "  or locate this package and run its postinstall script directly:" >&2
  echo "    sh \$(npm root -g)/sos-kit/scripts/npm-postinstall.sh" >&2
  exit 1
fi

exec "$TARGET" "$@"
